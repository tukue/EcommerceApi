# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/microstore
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=microstore

# Session (generate a random string: openssl rand -hex 32)
SESSION_SECRET=replace-with-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
VITE_STRIPE_PUBLIC_KEY=pk_test_replace_with_your_key

# SMTP / Email Notifications
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-email@ethereal.email
SMTP_PASS=replace-with-your-password
NOTIFICATION_EMAIL=notifications@example.com

# Node Environment
NODE_ENV=development
